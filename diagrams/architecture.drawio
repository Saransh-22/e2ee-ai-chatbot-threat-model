        <mxCell id="tb-dmz" value="[TB-02] PERIMETER &amp; MESSAGE RELAY ZONE (Untrusted Public Transit)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#f59e0b;strokeWidth=2;dashed=1;fontColor=#b45309;fontStyle=1;fontSize=12;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="340" height="700" as="geometry" />
        </mxCell>
        <mxCell id="dmz-gateway" value="Secure Gateway (Ingress WAF)&#xa;TLS 1.3 Termination &amp; Rate Limiter&#xa;&#xa;[Threats: THR-003, THR-013]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontStyle=1;fontSize=12;" vertex="1" parent="tb-dmz">

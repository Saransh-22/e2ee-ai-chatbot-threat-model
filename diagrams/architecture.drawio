        <mxCell id="flow-admin-ctrl" value="Security Policies &amp; Keys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1;dashed=1;fontColor=#5b21b6;fontSize=9;" edge="1" parent="1" source="mgmt-admin" target="dmz-gateway">
          <mxGeometry relative="1" as="geometry">

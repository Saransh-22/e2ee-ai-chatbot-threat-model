        <mxCell id="mgmt-siem" value="SIEM &amp; Security Monitoring&#xa;Intrusion &amp; Anomaly Detection Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="tb-mgmt">

        <!-- LEGEND & STRIDE MAPPING BOX -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="STRIDE THREAT TAXONOMY &amp; TRUST BOUNDARY LEGEND" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-tb" value="TRUST BOUNDARIES:&#xa;• [TB-01] Client Zone (Untrusted Device Environment, Physical Access Risk)&#xa;• [TB-02] Ingress &amp; Relay DMZ (Untrusted Internet Transit, Eavesdropping &amp; DDoS Target)&#xa;• [TB-03] AI Processing Enclave (Confidential Computing Core, Plaintext Processing Zone)&#xa;• [TB-04] Management Zone (Administrative Control Plane, High Privilege Target)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="60" y="895" width="700" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-stride" value="STRIDE CATEGORIES:&#xa;• S - Spoofing: Forging identity of client, relay, or AI inference worker.&#xa;• T - Tampering: Modifying ciphertext, keys, or prompt injections.&#xa;• R - Repudiation: Denying dispatched prompts or altering audit trail.&#xa;• I - Information Disclosure: KV cache leaks, RAM scraping, traffic profiling.&#xa;• D - Denial of Service: TLS handshake floods, prompt algorithmic complexity.&#xa;• E - Elevation of Privilege: IDOR, JWT confusion, container escapes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="800" y="895" width="730" height="130" as="geometry" />
        </mxCell>

      </root>

        <!-- DATA FLOW CONNECTIONS -->
        <!-- 1. Client to Key Management -->
        <mxCell id="flow-1" value="1. Key Ratchet / Session Init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=10;" edge="1" parent="1" source="client-user" target="client-keys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 2. Client to Auth -->
        <mxCell id="flow-2" value="2. Auth Request &amp; Token Grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;" edge="1" parent="1" source="client-user" target="dmz-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 3. Client to Gateway -->
        <mxCell id="flow-3" value="3. Outgoing Encrypted Prompt (E2EE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;fontSize=10;" edge="1" parent="1" source="client-keys" target="dmz-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 4. Gateway to Relay -->
        <mxCell id="flow-4" value="4. Ingress Forwarding (Ciphertext)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#9a3412;fontSize=10;" edge="1" parent="1" source="dmz-gateway" target="dmz-relay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 5. Relay to AI API Layer -->
        <mxCell id="flow-5" value="5. Queue Dispatch (Ciphertext Blob)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=10;" edge="1" parent="1" source="dmz-relay" target="ai-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 6. API to Guardrail In -->
        <mxCell id="flow-6" value="6. Decrypted Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;fontSize=10;" edge="1" parent="1" source="ai-api" target="ai-guardrail-in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 7. Guardrail In to AI Model -->
        <mxCell id="flow-7" value="7. Sanitized Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891b2;strokeWidth=2;fontColor=#155e75;fontSize=10;" edge="1" parent="1" source="ai-guardrail-in" target="ai-model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 8. AI Model to Guardrail Out -->
        <mxCell id="flow-8" value="8. Generated Tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0891b2;strokeWidth=2;fontColor=#155e75;fontSize=10;" edge="1" parent="1" source="ai-model" target="ai-guardrail-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 9. Guardrail Out to Resp Encryption -->
        <mxCell id="flow-9" value="9. Filtered AI Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#6b21a8;fontSize=10;" edge="1" parent="1" source="ai-guardrail-out" target="ai-resp-enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 10. Resp Encryption to Relay Return -->
        <mxCell id="flow-10" value="10. Re-encrypted Ciphertext Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#6b21a8;fontSize=10;" edge="1" parent="1" source="ai-resp-enc" target="dmz-relay">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="680" />
              <mxPoint x="820" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 11. Relay Return to Client -->
        <mxCell id="flow-11" value="11. Push E2EE Response to Client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1d4ed8;fontSize=10;" edge="1" parent="1" source="dmz-relay" target="client-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AUDIT & ADMIN FLOWS -->
        <mxCell id="flow-audit-1" value="Audit Log Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#db2777;strokeWidth=1;dashed=1;fontColor=#9d174d;fontSize=9;" edge="1" parent="1" source="dmz-gateway" target="mgmt-audit">

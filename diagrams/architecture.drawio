        </mxCell>
        <mxCell id="flow-audit-2" value="Inference Metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#db2777;strokeWidth=1;dashed=1;fontColor=#9d174d;fontSize=9;" edge="1" parent="1" source="ai-api" target="mgmt-audit">
          <mxGeometry relative="1" as="geometry" />
